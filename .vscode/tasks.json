{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev - odpal stronę (zamiennik Go Live)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build - sprawdź czy się buduje",
      "type": "npm",
      "script": "build",
      "presentation": {
        "reveal": "always"
      },
      "group": "build"
    },
    {
      "label": "start - podgląd produkcyjny",
      "type": "npm",
      "script": "start",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
